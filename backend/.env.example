# Backend FastAPI — biến môi trường (file mẫu; các giá trị chỉ là mặc định dev)
# Lưu ý: backend đọc biến từ process env (os.getenv) — khi chạy thủ công hãy
# `export` các biến này (hoặc dùng docker-compose, service backend được set tự động).

# DSN PostgreSQL (PostGIS khuyến khích; không có PostGIS vẫn chạy được —
# hình học được xử lý trong lớp Python/Shapely)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rideshift

# Cổng HTTP khi chạy standalone
BACKEND_PORT=8000

# Pepper cho mã hoá mật khẩu quản trị: SALT$sha256(SALT:password)
RIDESHIFT_SALT=rideshift-c1se48
