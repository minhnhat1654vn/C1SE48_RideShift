# ============================================================
# RideShift — Smart Transport Transition Advisor (C1SE.48)
# Copy this file to `.env` next to docker-compose.yml
# ============================================================

# ── PostgreSQL / PostGIS (service `db`) ───────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rideshift

# ── Backend (FastAPI) ─────────────────────────────────────
# docker-compose tự ghép DATABASE_URL từ 3 biến phía trên;
# giá trị dưới đây chỉ dùng khi chạy backend thủ công bên ngoài Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rideshift
BACKEND_PORT=8000
# Pepper cho mã hoá mật khẩu quản trị (SALT$sha256(SALT:password))
RIDESHIFT_SALT=rideshift-c1se48

# ── Frontend (Next.js) ────────────────────────────────────
# Origin của backend FastAPI mà trình duyệt gọi trực tiếp.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Goong (Zalo) - geocode so nha VN (dang ky tai goong.io; de trong neu chua co)
GOONG_API_KEY=
